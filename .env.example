VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Optional: enables free Web Push notifications. Get one with `npm run vapid`.
VITE_VAPID_PUBLIC_KEY=

# Edge Function secrets (copy to Supabase; not exposed to the browser):
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
